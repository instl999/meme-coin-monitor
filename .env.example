# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Easier: run `python holder_watch.py setup` (or `... telegram`). It asks for the keys with hidden
# input, checks that they work, finds your Telegram chat ID for you and writes this file.
# Environment variables that are already set take precedence over this file.

# Solana RPC key. The free public RPC refuses getTokenLargestAccounts (HTTP 429),
# so holder monitoring needs a provider key. Free Helius key: https://dashboard.helius.dev
# When set (and config.json keeps the default public rpc_url), Helius is used automatically.
HELIUS_API_KEY=

# Optional: full RPC URL for another provider; overrides config.json rpc_url.
# SOLANA_RPC_URL=

# Ethereum, Base, BNB Chain and Arbitrum. Without any key, trades of wallets on Ethereum, Base and
# Arbitrum are still watched through those chains' public RPCs. A free Ankr key (200M credits a
# month) adds BNB Chain, finding a token's traders and building built-in trader lists on all four:
# https://www.ankr.com/rpc/ -> sign up -> the API key is the last part of any endpoint URL.
ANKR_API_KEY=

# Optional instead of Ankr: an Alchemy key (one key for all four chains).
# ALCHEMY_API_KEY=

# Optional: your own RPC URL for one EVM chain (receipts and balances; wallet histories still come
# from Ankr when ANKR_API_KEY is set).
# ETHEREUM_RPC_URL=
# BASE_RPC_URL=
# BSC_RPC_URL=
# ARBITRUM_RPC_URL=

# Telegram alerts (optional; without them alerts go to the console and log file only).
# `python holder_watch.py telegram` does all of this for you. By hand:
# 1. Message @BotFather on Telegram, send /newbot, copy the token it gives you.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
